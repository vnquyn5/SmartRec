
# GPU Server Tailscale address
GPU_TAILSCALE_IP=100.x.x.x

# Mac Tailscale address
BACKEND_BASE_URL=http://100.x.x.x:8082/api/v1
MINIO_ENDPOINT=http://100.x.x.x:9000

# Shared authentication
SMARTREC_INTERNAL_TOKEN=REPLACE_ME

# Hugging Face gated model access
HF_TOKEN=REPLACE_ME

# MinIO credentials - must match Mac MinIO
MINIO_USER=REPLACE_ME
MINIO_PASSWORD=REPLACE_ME
MINIO_BUCKET=smartrec-media

# Celery settings
CELERY_WORKER_CONCURRENCY=1

# Diarization settings
PYANNOTE_DEVICE=cuda
