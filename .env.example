# Môi trường phát triển SmartRec trên máy local.
# Sao chép file này thành .env và thay các giá trị mẫu được ghi chú.
# Không commit .env và không ghi thông tin xác thực thật vào file mẫu này.

# Bắt buộc cho ai-engine và ai-worker. Đặt một giá trị ngẫu nhiên riêng
# và dùng CÙNG giá trị đó trong môi trường chạy Spring Boot native.
SMARTREC_INTERNAL_TOKEN=REPLACE_WITH_A_RANDOM_PRIVATE_TOKEN

# PostgreSQL (giá trị mặc định cho môi trường phát triển local)
POSTGRES_DB=smartrec_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

# MinIO (giá trị mặc định local; đồng bộ với cấu hình Spring Boot bên dưới)
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET=smartrec-media

# Token Hugging Face để truy cập model Pyannote có giới hạn quyền.
# Chỉ để trống nếu dùng native Pyannote service đã được cấu hình riêng
# hoặc một phương án khác có quyền truy cập model hợp lệ.
HF_TOKEN=

# Backend diarization:
# local = Pyannote chạy bên trong Docker worker (cần HF_TOKEN)
# http  = worker gọi native service được cài đặt riêng
DIARIZATION_BACKEND=local
PYANNOTE_NATIVE_URL=http://host.docker.internal:8086
PYANNOTE_NATIVE_TOKEN=

# Chuyển giọng nói thành văn bản. Cổng mặc định hiện tại trong Compose là 8081.
STT_PROVIDER=whisper_cpp
WHISPER_CPP_URL=http://host.docker.internal:8081/inference
STT_MODEL_PATH=
STT_TIMEOUT_SECONDS=3600
STT_CPU_THREADS=4

# Cài model này trong Ollama trên Mac trước khi chạy các AI job.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_NUM_CTX=3072
OLLAMA_TIMEOUT_SECONDS=900

# Địa chỉ Worker gọi callback/API của Spring Boot. Spring Boot chạy trên Mac.
BACKEND_BASE_URL=http://host.docker.internal:8082/api/v1
SMARTREC_HEARTBEAT_INTERVAL_SECONDS=12
CELERY_WORKER_CONCURRENCY=1

# Các biến tùy chọn cho Spring Boot native.
# Compose không tự truyền các biến này cho Spring Boot. Hãy export chúng
# trong terminal chạy ./mvnw và dùng các giá trị đồng nhất với cấu hình trên.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smartrec_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=123456
REDIS_HOST=localhost
REDIS_PORT=6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PLAYBACK_URL_EXPIRY_SECONDS=900
AI_ENGINE_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Các cấu hình Spring Boot tùy chọn. Chỉ đặt theo nhu cầu phát triển local.
JOB_HEARTBEAT_TIMEOUT_SECONDS=90
JOB_WATCHDOG_SCAN_INTERVAL_MS=30000
TRASH_RETENTION_DAYS=30
# TRASH_PURGE_CRON=0 0 2 * * *
# Nếu thay giá trị mặc định chỉ dành cho phát triển trong application.yml,
# hãy đặt JWT_SECRET riêng tư và đủ mạnh bên ngoài file mẫu này.
# JWT_SECRET=

