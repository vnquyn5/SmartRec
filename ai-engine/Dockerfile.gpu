# NVIDIA GPU worker - chưa kiểm thử thực tế
# Linux AMD64 / CUDA 12.8

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ffmpeg libsndfile1 libgomp1 && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements_ai.txt ./

# PyTorch CUDA - cần xác minh trên NVIDIA GPU.
# PyTorch CUDA 12.8
RUN python -m pip install \
    torch==2.11.0 torchaudio==2.11.0 \
    --index-url https://download.pytorch.org/whl/cu128

# TorchCodec 0.16.0 is unavailable in the cu128 index.
# CPU wheel: installation fallback; CUDA runtime not yet verified.
RUN python -m pip install --no-deps \
    torchcodec==0.16.0 \
    --index-url https://download.pytorch.org/whl/cpu

RUN python -m pip install \
    -r requirements.txt -r requirements_ai.txt && \
    python -m pip check && \
    python -c "import torch, pyannote.audio; assert torch.version.cuda is not None"

COPY app ./app
COPY model_registry.json ./model_registry.json

CMD ["celery", "-A", "app.celery_app.celery_app", \
     "worker", "--loglevel=INFO", "--concurrency=1"]
