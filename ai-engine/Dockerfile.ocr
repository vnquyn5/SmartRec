# SmartRec Sprint 3 - OCR CPU
# Target: Linux ARM64 / AMD64
# Python 3.11

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ffmpeg \
       libgomp1 \
       libglib2.0-0 \
       libgl1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements_ocr.txt ./

RUN python -m pip install \
    --no-cache-dir \
    -r requirements_ocr.txt \
    && python -m pip check

COPY app ./app
COPY model_registry.json ./model_registry.json

# Temporary smoke-test command.
# The OCR worker entry point will be configured
# after Celery integration is verified.
CMD ["python", "-c", "import paddle, paddleocr, cv2, skimage; print('SmartRec OCR runtime imports OK')"]
