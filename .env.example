# Docker Compose reads root .env; ai-engine/.env is only for native Python.
# Copy locally and fill paths/secrets. Never commit .env.
# In the hybrid E2E setup, Ollama runs on macOS and Docker FastAPI uses
# host.docker.internal. Native worker settings live in ai-engine/.env.
SMARTREC_INTERNAL_TOKEN=replace-with-a-secure-token
SMARTREC_MODELS_DIR=/absolute/path/to/models
SMARTREC_HF_CACHE_DIR=/absolute/path/to/huggingface
LOCAL_LLM_ENDPOINT=http://host.docker.internal:11434/api/generate
LOCAL_LLM_MODEL=qwen2.5:3b-instruct-q4_K_M
SMARTREC_LLM_ENABLED=true
BACKEND_BASE_URL=http://host.docker.internal:8082/api/v1
POSTGRES_DB=smartrec_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-postgres-password
MINIO_USER=replace-with-minio-user
MINIO_PASSWORD=replace-with-minio-password
MINIO_BUCKET=smartrec-media
STT_MODEL_ID=faster-whisper-small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
DIARIZATION_DEVICE=cpu
HF_TOKEN=replace-with-huggingface-token
CELERY_WORKER_CONCURRENCY=1
SMARTREC_HEARTBEAT_INTERVAL_SECONDS=12
# These STT/OCR paths are for the optional Docker compatibility worker;
# the supported native worker is configured in ai-engine/.env.
# Paths INSIDE the container; host models are mounted at /models.
OCR_RECOGNITION_MODEL_DIR=/models/ocr/PP-OCRv6_medium_rec
OCR_DETECTION_MODEL_DIR=/models/ocr/PP-OCRv6_medium_det

# Spring Boot runs on the host (not a Compose service).
# Supply the SAME SMARTREC_INTERNAL_TOKEN above to its process environment.
# Spring Boot does not automatically load this file.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smartrec_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-postgres-password
REDIS_HOST=localhost
REDIS_PORT=6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=replace-with-minio-user
MINIO_SECRET_KEY=replace-with-minio-password
AI_ENGINE_BASE_URL=http://localhost:8000
GEMINI_FALLBACK_ENABLED=false
GEMINI_DATA_SHARING_APPROVED=false
