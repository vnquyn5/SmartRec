# ==================================================
# SmartRec Frontend - Development Environment
# ==================================================
# Only public Vite configuration belongs here.
# Never put backend tokens, JWT secrets, passwords,
# Hugging Face tokens, or MinIO secret keys here.

# Spring Boot REST API
VITE_API_BASE_URL=http://localhost:8082/api/v1

# Google OAuth 2.0 public Client ID
# Optional: configure only when Google Login is used.
VITE_GOOGLE_CLIENT_ID=
