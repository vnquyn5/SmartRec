# ============================================================
# SmartRec AI Engine - Native Development Configuration
# ============================================================
# Copy to ai-engine/.env and configure values locally.
# DO NOT commit the real .env file.
#
# This template targets FastAPI + Celery running natively.
# PostgreSQL, Redis, MinIO and ChromaDB may run in Docker.

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_NAME=smartrec-ai-engine
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Redis / Celery
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ------------------------------------------------------------
# MinIO
# ------------------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=smartrec-media

# ------------------------------------------------------------
# ChromaDB
# ------------------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ------------------------------------------------------------
# Spring Boot / Internal Authentication
# ------------------------------------------------------------
BACKEND_BASE_URL=http://127.0.0.1:8082/api/v1

# Must match the Backend internal token.
SMARTREC_INTERNAL_TOKEN=CHANGE_ME

# ------------------------------------------------------------
# Hugging Face / Pyannote
# ------------------------------------------------------------
HF_TOKEN=CHANGE_ME
PYANNOTE_MODEL_ID=pyannote/speaker-diarization-3.1

# auto | cpu | mps | cuda
DIARIZATION_DEVICE=auto
# raw is backward-compatible; exclusive requires native pipeline output.
PYANNOTE_TIMELINE_MODE=raw
# Optional diagnostics-only micro-turn detection for exclusive timelines.
PYANNOTE_TURN_SMOOTHING_ENABLED=false
PYANNOTE_TURN_SMOOTHING_MAX_FRAGMENT_MS=150
# Optional speaker-count constraints (choose exact OR min/max; unset means automatic)
# PYANNOTE_NUM_SPEAKERS=2
# PYANNOTE_MIN_SPEAKERS=2
# PYANNOTE_MAX_SPEAKERS=4

# ------------------------------------------------------------
# Native STT backend
# ------------------------------------------------------------
# whisper.cpp Q5 Large-v3-Turbo Metal/CPU backend. This path is relative to
# ai-engine when the worker is started using the guide command.
STT_BACKEND=whisper.cpp
STT_MODEL_ID=whisper.cpp-large-v3-turbo-q5_0
WHISPER_MODEL_PATH=../models/whisper/ggml-large-v3-turbo-q5_0.bin
WHISPER_CPP_BIN=whisper-cli
WHISPER_CPP_DEVICE=auto
WHISPER_CPP_THREADS=4
WHISPER_CPP_TIMEOUT_SECONDS=1800
WHISPER_CPP_CPU_FALLBACK=true

# CTranslate2 fallback only; CTranslate2 does not use Apple MPS.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ------------------------------------------------------------
# Local Workspace
# ------------------------------------------------------------
SMARTREC_WORKSPACE_ROOT=/tmp/smartrec_workspace

# Local Ollama (FastAPI)
LOCAL_LLM_ENDPOINT=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=qwen2.5:3b-instruct-q4_K_M

# Local PaddleOCR models; both are required for video jobs (no runtime downloads).
OCR_RECOGNITION_MODEL_DIR=/absolute/path/to/PP-OCRv6_medium_rec
OCR_DETECTION_MODEL_DIR=/absolute/path/to/PP-OCRv6_medium_det
OCR_DEVICE=cpu

# Existing host Hugging Face cache for native Python (Compose mounts it separately).
HF_HOME=/absolute/path/to/huggingface
HF_HUB_CACHE=/absolute/path/to/huggingface/hub
PYANNOTE_CACHE=/absolute/path/to/huggingface/hub
